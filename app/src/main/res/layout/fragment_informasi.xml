<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".Informasi.InformasiFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F8F9FA"
            app:layout_constraintTop_toTopOf="parent"
            app:titleTextColor="#2B2D42" />

        <!-- Area Foto Highlight -->
        <ImageView
            android:id="@+id/imgHighlight"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="#E0E0E0"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />

        <!-- Kartu Hijau Highlight -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHighlight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="-40dp"
            app:cardBackgroundColor="#1E5631"
            app:cardCornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/imgHighlight">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/txtJudulHighlight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Judul Informasi Utama"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtTanggalHighlight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="02 Oktober 2026"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Judul Info Terkini -->
        <TextView
            android:id="@+id/txtHeaderTerkini"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="32dp"
            android:text="Info Terkini"
            android:textColor="#2B2D42"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardHighlight" />

        <TextView
            android:id="@+id/txtLihatSemua"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="Semua >"
            android:textColor="#555555"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/txtHeaderTerkini"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/txtHeaderTerkini" />

        <!-- RecyclerView Horizontal -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvInfoTerkini"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtHeaderTerkini" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>